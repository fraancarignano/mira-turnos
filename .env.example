# Copiá este archivo a .env.local y completá los valores. .env.local no se sube al repo.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo server (cron)

# Conexión directa a Postgres, solo para tests de base (tests/db) y migraciones.
# Dashboard → Connect → "Session pooler". Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
SUPABASE_DB_URL=
# Ref del proyecto (lo que va en https://<ref>.supabase.co), para generar tipos
SUPABASE_PROJECT_REF=

NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=                       # ej. turnos@<dominio-mira-studio>
CRON_SECRET=
MIRA_STUDIO_WHATSAPP=             # para el CTA del banner demo
